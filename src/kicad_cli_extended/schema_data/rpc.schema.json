{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "kce rpc",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "id": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "result": {},
    "error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "data": {}
      }
    }
  },
  "required": [
    "jsonrpc",
    "id"
  ],
  "oneOf": [
    {
      "required": [
        "result"
      ],
      "not": {
        "required": [
          "error"
        ]
      }
    },
    {
      "required": [
        "error"
      ],
      "not": {
        "required": [
          "result"
        ]
      }
    }
  ]
}
