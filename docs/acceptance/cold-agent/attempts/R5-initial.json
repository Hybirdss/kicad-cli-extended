            },
            {
              "path": "outside_outline.count",
              "op": "eq",
              "value": 0
            }
          ]
        },
        {
          "args": [
            "pcb",
            "footprints",
            "--pads"
          ]
        },
        {
          "args": [
            "project",
            "compare",
            "checkpoint:pre-eco",
            "--geometry",
            "--allow",
            "C2,C10,net:SUPPLY_NET,net:GROUND_NET",
            "--fail-on-unexpected"
          ]
        }
      ]
    },
    "OUTSIDE_P/route-eco.json": {
      "version": 1,
