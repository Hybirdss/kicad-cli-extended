  "plans": {
    "OUTSIDE_P/schematic-eco.json": {
      "version": 1,
      "steps": [
        {
          "args": [
            "sch",
            "set-value",
            "C2",
            "220uF"
          ]
        },
        {
          "args": [
            "sch",
            "set-field",
            "C2",
            "Voltage",
            "35V"
          ]
        },
        {
          "args": [
            "sch",
            "set-field",
            "C2",
            "Manufacturer",
            "Panasonic"
          ]
        },
        {
          "args": [
            "sch",
            "set-field",
            "C2",
            "MPN",
            "EEU-FR1V221"
          ]
        },
        {
          "args": [
            "sch",
            "set-footprint",
            "C2",
            "Capacitor_THT:CP_Radial_D8.0mm_P3.50mm"
          ]
        },
        {
          "args": [
            "sch",
            "add",
            "Device:C",
            "--ref",
            "C10",
            "--at",
            "SCH_XY",
            "--value",
            "100nF",
            "--footprint",
            "Capacitor_SMD:C_0603_1608Metric"
          ]
        },
        {
          "args": [
            "sch",
            "connect",
            "C10:1",
            "U2:14"
          ]
        },
        {
          "args": [
            "sch",
            "connect",
            "C10:2",
            "U2:7"
          ]
        },
        {
          "args": [
            "sch",
            "show",
            "C2"
          ],
          "expect": [
            {
              "path": "value",
              "op": "eq",
              "value": "220uF"
            }
          ]
        },
        {
          "args": [
            "sch",
            "show",
            "C10"
          ],
          "expect": [
            {
              "path": "value",
              "op": "eq",
              "value": "100nF"
            }
          ]
        },
        {
          "args": [
            "sch",
            "nets"
          ]
        },
        {
          "args": [
            "check",
            "erc",
            "--baseline",
            "OUTSIDE_P/baseline-erc.json",
            "--fail-on",
            "error"
          ]
        }
      ]
    },
    "OUTSIDE_P/sync-eco.json": {
      "version": 1,
      "steps": [
        {
          "args": [
            "pcb",
            "update",
            "--keep-extra",
            "--no-place",
            "--lock-existing"
          ],
          "expect": [
            {
              "path": "unmatched_pins",
              "op": "empty"
            }
          ]
        },
        {
          "args": [
            "pcb",
            "footprints",
            "--pads"
          ]
        },
        {
          "args": [
            "project",
            "compare",
            "checkpoint:pre-eco",
            "--geometry",
            "--allow",
            "C2,C10,net:SUPPLY_NET,net:GROUND_NET",
            "--fail-on-unexpected"
          ]
        }
      ]
    },
    "OUTSIDE_P/place-eco.json": {
      "version": 1,
      "steps": [
        {
          "args": [
            "pcb",
            "lock",
            "--all",
            "--except",
            "C10"
          ]
        },
        {
          "args": [
            "pcb",
            "place",
            "near",
            "C10",
            "--to",
            "U2:14",
            "--max-dist",
            "6",
            "--grid",
            "0.25",
            "--rotation",
            "auto"
          ]
        },
        {
          "args": [
