  "plans": {
    "scratch-rc.json": {
      "version": 1,
      "steps": [
        {
          "args": [
            "sch",
            "add",
            "Simulation_SPICE:VDC",
            "--ref",
            "V1",
            "--at",
            "25.4,50.8"
          ]
        },
        {
          "args": [
            "sch",
            "add",
            "Device:R",
            "--ref",
            "R1",
            "--at",
            "50.8,50.8",
            "--value",
            "1.6k"
          ]
        },
        {
          "args": [
            "sch",
            "add",
            "Device:C",
            "--ref",
            "C1",
            "--at",
            "76.2,50.8",
            "--value",
            "100n"
          ]
        },
        {
          "args": [
            "sch",
            "label-pin",
            "V1:1",
            "in"
          ]
        },
        {
          "args": [
            "sch",
            "label-pin",
            "R1:1",
            "in"
          ]
        },
        {
          "args": [
            "sch",
            "label-pin",
            "R1:2",
            "out"
          ]
        },
        {
          "args": [
            "sch",
            "label-pin",
            "C1:1",
            "out"
          ]
        },
        {
          "args": [
            "sch",
            "label-pin",
            "V1:2",
            "0",
            "--kind",
            "global"
          ]
        },
        {
          "args": [
            "sch",
            "label-pin",
            "C1:2",
            "0",
            "--kind",
            "global"
          ]
        },
        {
          "args": [
            "sim",
            "model",
            "V1",
            "--device",
            "V",
            "--type",
            "DC",
            "--params",
            "dc=0 ac=1"
          ]
        },
        {
          "args": [
            "sim",
            "model",
            "R1",
            "--device",
            "R",
            "--params",
            "r=1.6k"
          ]
        },
        {
          "args": [
            "sim",
            "model",
            "C1",
            "--device",
            "C",
            "--params",
            "c=100n"
          ]
        },
        {
          "args": [
            "sim",
            "directive",
            "add",
            ".ac dec 100 10 100k"
          ]
        }
      ]
    },
    "insert-rc.json": {
      "version": 1,
      "steps": [
        {
          "args": [
            "sch",
            "delete-item",
            "ADC_BRANCH_UUID"
          ]
        },
        {
          "args": [
            "sch",
            "apply",
            "expected-rc-intent.json",
            "--patch"
          ]
        },
        {
          "args": [
            "sch",
            "verify",
            "--expect",
            "expected-rc-intent.json",
            "--strict"
          ]
        },
        {
          "args": [
            "check",
            "erc",
            "--fail-on",
            "error"
          ]
        }
      ]
    },
    "place-rc.json": {
      "version": 1,
      "steps": [
        {
          "args": [
            "pcb",
            "place",
            "near",
            "C_NEW",
            "--to",
            "U_ADC:AIN2_PAD",
            "--max-dist",
            "3",
            "--grid",
            "0.1",
            "--rotation",
            "auto"
          ]
        },
        {
          "args": [
            "pcb",
            "place",
            "near",
            "R_NEW",
            "--to",
            "C_NEW",
            "--max-dist",
            "5",
            "--grid",
            "0.1",
            "--rotation",
            "auto"
          ]
        },
        {
          "args": [
            "pcb",
            "score"
          ],
          "expect": [
            {
              "path": "courtyard_overlaps.count",
              "op": "eq",
              "value": 0
            },
            {
              "path": "outside_outline.count",
              "op": "eq",
              "value": 0
            }
          ]
        }
      ]
    }
  },
  "reads": [
    "cat /home/example/.omo/waves/kce-p4/cold-agent/skills/kicad-cli-extended/SKILL.md /home/example/.omo/waves/kce-p4/cold-agent/skills/kicad-cli-extended/COMMANDS.md",
